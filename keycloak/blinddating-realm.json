{
  "realm": "blinddating",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": true,
  "registrationEmailAsUsername": false,
  "loginWithEmailAllowed": false,
  "editUsernameAllowed": false,
  "verifyEmail": false,
  "resetPasswordAllowed": false,
  "passwordPolicy": "length(8)",
  "components": {
    "org.keycloak.userprofile.UserProfileProvider": [
      {
        "providerId": "declarative-user-profile",
        "config": {
          "kc.user.profile.config": [
            "{\"attributes\":[{\"name\":\"username\",\"displayName\":\"${username}\",\"validations\":{\"length\":{\"min\":1,\"max\":20},\"pattern\":{\"pattern\":\"^[a-zA-Z0-9]+$\",\"error-message\":\"Use 1–20 letters or digits.\"}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]}},{\"name\":\"email\",\"displayName\":\"${email}\",\"validations\":{\"email\":{}},\"permissions\":{\"view\":[\"admin\"],\"edit\":[\"admin\"]}}]}"
          ]
        }
      }
    ]
  },
  "clients": [
    {
      "clientId": "blinddating-frontend",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://localhost:4200/*",
        "http://localhost:8080/*",
        "http://frontend.blinddatingapp.finkingma.com/*"
      ],
      "webOrigins": [
        "http://localhost:4200",
        "http://localhost:8080",
        "http://frontend.blinddatingapp.finkingma.com"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:4200/*##http://localhost:8080/*##http://frontend.blinddatingapp.finkingma.com"
      },
      "defaultClientScopes": [],
      "protocolMappers": [
        {
          "name": "profile-service audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "profile-service",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "username",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "config": {
            "user.attribute": "username",
            "claim.name": "preferred_username",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "protocolMapper": "oidc-sub-mapper",
          "protocol": "openid-connect",
          "name": "sub",
          "config": {
            "introspection.token.claim": "true",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ]
}
